# Pulari Bakes Environment Template
# Copy to admin/.env and pantry-management/.env

VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-PUBLISHABLE-KEY]

# Direct PostgreSQL Database Connection (used by database migration and backup tools)
# Examples:
# Self-hosted / Docker: postgresql://pulari_admin:pulari_secure_pass_2026@localhost:5432/pulari_bakes_db
# Supabase Pooler: postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
